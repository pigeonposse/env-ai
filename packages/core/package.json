	},
	"type": "module",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"main": "dist/index.js",
	"module": "./dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "node build.lib.js",
		"dev": "bun examples/index.ts",
		"dev:bun": "bun examples/index.ts",
		"dev:deno": "deno run -A --unstable-sloppy-imports examples/index.ts $@",
		"test": "vitest run tests"
	},
	"devDependencies": {
		"@clack/prompts": "1.4.0",
		"@langchain/classic": "1.0.32",
		"@langchain/core": "1.1.46",
		"@langchain/ollama": "1.2.7",
		"@structium/toml": "~0.0.7",
		"@structium/yaml": "~0.0.7",
		"ai": "6.0.184",
		"clippium": "~1.0.3",
		"globby": "16.2.0",
		"ollama": "0.6.3",
		"ollama-ai-provider-v2": "3.5.1",
		"zod": "4.4.3"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	}
}
